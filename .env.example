# Copy this file to .env and fill in your own values.
# Never commit .env — it's already in .gitignore.

# ── Sales Cloud / Service Cloud ────────────────────────────────────────
# From Setup > App Manager > New Connected App in your org.
# Enable OAuth, check "Require PKCE", callback URL must match SF_REDIRECT_URI.
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:8765/callback

# ── Marketing Cloud (separate product, separate credentials) ──────────
# From Setup > Apps > Installed Packages > New (API Integration, server-to-server).
MC_SUBDOMAIN=
MC_CLIENT_ID=
MC_CLIENT_SECRET=
MC_ACCOUNT_ID=

# ── Remote/cloud variant only (server_remote.py) ───────────────────────
# Run setup_salesforce_auth.py locally once, then copy the refresh_token
# value out of the .salesforce_token.json it creates into this variable
# (or your cloud provider's secret manager) when deploying remotely.
# Not used by the local variant (server.py) — it reads the token file.
SF_REFRESH_TOKEN=

# Required before deploying anywhere network-reachable. Any long random
# string; callers must send it as "Authorization: Bearer <this value>".
MCP_SHARED_SECRET=

# Port the remote server listens on. Cloud Run/App Runner/Container Apps
# set this for you automatically — only set it yourself for local testing.
PORT=8080
